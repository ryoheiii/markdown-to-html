{
  "text-color": "#1f2328",
  "background-color": "#f6f8fa",
  "line-number-color": "#59636e",
  "line-number-background-color": null,
  "text-styles": {
    "Alert": { "text-color": "#82071e", "bold": true },
    "Annotation": { "text-color": "#59636e", "bold": true, "italic": true },
    "Attribute": { "text-color": "#0550ae" },
    "BaseN": { "text-color": "#0550ae" },
    "BuiltIn": { "text-color": "#6639ba" },
    "Char": { "text-color": "#0a3069" },
    "Comment": { "text-color": "#59636e", "italic": true },
    "CommentVar": { "text-color": "#59636e", "bold": true, "italic": true },
    "Constant": { "text-color": "#0550ae" },
    "ControlFlow": { "text-color": "#cf222e", "bold": true },
    "DataType": { "text-color": "#953800" },
    "DecVal": { "text-color": "#0550ae" },
    "Documentation": { "text-color": "#59636e", "italic": true },
    "Error": { "text-color": "#82071e", "bold": true },
    "Extension": { "text-color": "#6639ba" },
    "Float": { "text-color": "#0550ae" },
    "Function": { "text-color": "#6639ba" },
    "Import": { "text-color": "#cf222e" },
    "Information": { "text-color": "#0550ae" },
    "Keyword": { "text-color": "#cf222e", "bold": true },
    "Operator": { "text-color": "#1f2328" },
    "Other": { "text-color": "#1f2328" },
    "Preprocessor": { "text-color": "#cf222e" },
    "RegionMarker": { "text-color": "#59636e", "italic": true },
    "SpecialChar": { "text-color": "#0a3069" },
    "SpecialString": { "text-color": "#0a3069" },
    "String": { "text-color": "#0a3069" },
    "Variable": { "text-color": "#953800" },
    "VerbatimString": { "text-color": "#0a3069" },
    "Warning": { "text-color": "#9a6700", "bold": true, "italic": true }
  }
}